{
  "name": "orbb-chrome-extension",
  "version": "1.1.4",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Chrome capture and social-saves extension for Orbb, powered by the Orbit SDK.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "npm run build",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "check:public": "node scripts/check-public.mjs",
    "package:release": "npm run check:public && npm run check && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@orbb/orbit-sdk": "0.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.31",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.25.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
