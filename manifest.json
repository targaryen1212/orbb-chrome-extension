{
  "manifest_version": 3,
  "name": "Orbb — Save anything",
  "short_name": "Orbb",
  "version": "1.1.4",
  "description": "Save pages, links, images, files, and social bookmarks to Orbb from Chrome's side panel.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://api.orbb.app/*"
  ],
  "optional_host_permissions": [
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.reddit.com/*",
    "https://reddit.com/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Orbb"
  },
  "side_panel": {
    "default_path": "dist/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
